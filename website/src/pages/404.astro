---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found — sun2snow" description="This page could not be found. Head back to sun2snow's personal space." noindex>
  <section class="not-found" aria-labelledby="not-found-heading">
    <p class="error-code">404 / NOT FOUND</p>
    <h1 id="not-found-heading">A little off the path.</h1>
    <p>This page doesn’t exist, or it may have moved.</p>
    <a class="button button-primary" href="/"><Icon name="arrow-left" size={17} /> Back home</a>
  </section>
</BaseLayout>
