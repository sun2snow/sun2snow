---
interface Props {
  name: 'arrow-up-right' | 'arrow-down' | 'code' | 'arrow-left';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-up-right' && <path d="M6 18 18 6M6 6h12v12" />}
  {name === 'arrow-down' && <path d="M12 4v16m-6-6 6 6 6-6" />}
  {name === 'arrow-left' && <path d="M20 12H4m6-6-6 6 6 6" />}
  {name === 'code' && <path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16" />}
</svg>
