---
interface Props {
  name: 'arrow-up-right' | 'arrow-down' | 'code' | 'arrow-left' | 'translate' | 'gamepad' | 'compass' | 'book' | 'chart';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-up-right' && <path d="M6 18 18 6M6 6h12v12" />}
  {name === 'arrow-down' && <path d="M12 4v16m-6-6 6 6 6-6" />}
  {name === 'arrow-left' && <path d="M20 12H4m6-6-6 6 6 6" />}
  {name === 'code' && <path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16" />}
  {name === 'translate' && <path d="M3 5h12M9 2v3M6 5c0 5 3 8 7 10M13 5c-1 5-4 8-9 10M13 22l4-10 4 10M15 18h4" />}
  {name === 'gamepad' && <>
    <path d="M7 6h10a4 4 0 0 1 4 3l1 8a2 2 0 0 1-3 2l-4-3H9l-4 3a2 2 0 0 1-3-2l1-8a4 4 0 0 1 4-3ZM6 11h4M8 9v4" />
    <circle cx="16" cy="10" r=".75" />
    <circle cx="18" cy="13" r=".75" />
  </>}
  {name === 'compass' && <>
    <circle cx="12" cy="12" r="9" />
    <polygon points="15.5 8.5 13.5 13.5 8.5 15.5 10.5 10.5 15.5 8.5" />
  </>}
  {name === 'book' && <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20" />}
  {name === 'chart' && <>
    <path d="M3 3v18h18" />
    <path d="m7 15 4-4 3 3 5-6" />
  </>}
</svg>
